# Asistente del portfolio (/api/chat).

# Clave gratuita de Groq: https://console.groq.com/keys
# Sin ella el chat responde 503 y ofrece el correo de Ana como alternativa.
GROQ_API_KEY=

# Enlace público de Cal.com donde el visitante elige hora, p. ej.
# https://cal.com/tu-usuario/entrevista
# Si se deja vacío, la tarjeta de reunión cae al correo de Ana.
CAL_BOOKING_URL=
