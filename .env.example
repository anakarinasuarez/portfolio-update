# Asistente del portfolio (/api/chat).

# Clave gratuita de Groq: https://console.groq.com/keys
# Sin ella el chat responde 503 y ofrece el correo de Ana como alternativa.
GROQ_API_KEY=

# Enlace público de Cal.com donde el visitante elige hora, p. ej.
# https://cal.com/tu-usuario/entrevista
# Si se deja vacío, la tarjeta de reunión cae al correo de Ana.
# Este es el de videollamada y el único obligatorio: los dos de abajo caen aquí
# si se dejan vacíos.
CAL_BOOKING_URL=

# Un event type por formato: la ubicación (Cal Video, teléfono, presencial) se
# fija en el event type y no se puede cambiar por URL, así que quien pide una
# llamada acaba en una videollamada si solo existe el enlace de arriba.
# Créalos en Cal con su ubicación y pega aquí sus enlaces.
CAL_BOOKING_URL_PHONE=
CAL_BOOKING_URL_INPERSON=

# Dominio de producción, SIN barra final. Alimenta canonical, sitemap.xml,
# robots.txt y las tarjetas Open Graph: si no coincide con el dominio real,
# Google indexa URLs que no existen. En local puede quedar vacío.
NEXT_PUBLIC_SITE_URL=
